<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Opt OUT of the repo's Central Package Management. This is an agent-eval fixture representing a plain,
         non-Spiderly app, so it keeps inline PackageReference versions (a fresh app looks like this). Without
         this opt-out, an in-tree build inherits the repo-root Directory.Packages.props (MSBuild walks up) and
         the inline versions would fail with NU1008. Kept in this csproj (not a parent dir) so it travels with
         the fixture when the eval harness copies plain-app/ out of the tree, staying CPM-immune wherever it
         is built. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
  </ItemGroup>

</Project>
