<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Proxies + Npgsql are what make RequirednessColumnNullabilityTests faithful: the real app runs
         UseLazyLoadingProxies over a RELATIONAL provider, and column nullability is decided by relational
         conventions the in-memory provider never runs. No connection is ever opened. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spiderly.Infrastructure\Spiderly.Infrastructure.csproj" />
    <ProjectReference Include="..\Spiderly.Security\Spiderly.Security.csproj" />
    <ProjectReference Include="..\Spiderly.Shared\Spiderly.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
