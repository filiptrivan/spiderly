{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/spiderly",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    { "input": "src/lib", "glob": "**/*.scss", "output": "styles" },
    { "input": "src/lib/i18n", "glob": "en.json", "output": "i18n" },
    { "input": "agent", "glob": "**/*", "output": "agent" }
  ]
}
