#!/bin/sh
# Local mirror of CI's drift guards (.github/workflows/ci.yml) so contract drift fails at commit
# time instead of after a CI round-trip. Gated: runs only when staged files touch guarded paths.
# Activate once per clone: git config core.hooksPath .githooks
# Bypass when needed: git commit --no-verify (CI remains the backstop)
set -e

staged=$(git diff --cached --name-only)

ssot_src='^(Spiderly\.MetadataExporter/|tools/(extract-ts-metadata\.mjs|gen-skill-docs\.mjs|package(-lock)?\.json)|Spiderly\.Shared/Contracts/ApiErrorCodes\.cs|Spiderly\.Shared/Enums/(MatchModeCodes|UIControlTypeCodes)\.cs|Spiderly\.Shared/Attributes/|Spiderly\.Security/Controllers/SecurityBaseController\.cs|Angular/projects/spiderly/src/lib/services/(helper-functions\.ts|validator-abstract\.service\.ts)|Angular/projects/spiderly/src/lib/controls/)'
ssot_artifacts='^(framework-metadata\.json|claude-plugins/skills/[^/]+/references/[^/]+\.generated\.md)'
ts_mirrors='^(Spiderly\.Shared/Contracts/ApiErrorCodes\.cs|Spiderly\.Shared/Enums/MatchModeCodes\.cs|Angular/projects/spiderly/src/lib/errors/api-error-codes\.ts|Angular/projects/spiderly/src/lib/enums/match-mode-enum-codes\.ts)$'

# --- Framework-metadata SSOT: regenerate, auto-stage when safe ---------------------------------
if echo "$staged" | grep -qE "$ssot_src|$ssot_artifacts"; then
  echo "pre-commit: staged changes touch framework-metadata SSOT paths — regenerating to verify sync..."

  if [ ! -d tools/node_modules ]; then
    (cd tools && npm ci)
  fi

  dotnet run --project Spiderly.MetadataExporter -- --out framework-metadata.json
  node tools/extract-ts-metadata.mjs
  node tools/gen-skill-docs.mjs

  stale=$(git diff --name-only -- framework-metadata.json 'claude-plugins/skills/*/references/*.generated.md')
  untracked_artifacts=$(git ls-files --others --exclude-standard -- framework-metadata.json 'claude-plugins/skills/*/references/*.generated.md')

  if [ -n "$stale$untracked_artifacts" ]; then
    # Auto-staging is only safe when the regen input (working tree) matches what is being
    # committed (index). Unstaged or untracked SSOT sources mean the regenerated artifacts
    # would encode source changes this commit does not contain.
    dirty_src=$({ git diff --name-only; git ls-files --others --exclude-standard; } | grep -E "$ssot_src" || true)
    if [ -n "$dirty_src" ]; then
      echo ""
      echo "pre-commit: artifacts were stale AND these SSOT sources have unstaged/untracked changes:"
      echo "$dirty_src" | sed 's/^/  /'
      echo "pre-commit: auto-staging the regenerated artifacts would commit content derived from sources outside this commit."
      echo "pre-commit: stage (or stash) those sources, then retry the commit."
      exit 1
    fi
    git add framework-metadata.json 'claude-plugins/skills/*/references/*.generated.md'
    echo "pre-commit: artifacts were stale — regenerated and auto-staged into this commit:"
    printf '%s\n' $stale $untracked_artifacts | sed 's/^/  /'
  else
    echo "pre-commit: framework-metadata SSOT is in sync."
  fi
fi

# --- C# <-> TS hand-maintained contract mirrors -------------------------------------------------
if echo "$staged" | grep -qE "$ts_mirrors"; then
  echo "pre-commit: staged changes touch C#<->TS contract mirrors — running TsContractMirrorTests..."
  if ! dotnet test Spiderly.Shared.Tests --filter TsContractMirrorTests --verbosity quiet --nologo; then
    echo ""
    echo "pre-commit: C# and TS contract mirrors diverged. Sync the member sets:"
    echo "  Spiderly.Shared/Contracts/ApiErrorCodes.cs  <->  Angular/projects/spiderly/src/lib/errors/api-error-codes.ts"
    echo "  Spiderly.Shared/Enums/MatchModeCodes.cs     <->  Angular/projects/spiderly/src/lib/enums/match-mode-enum-codes.ts"
    exit 1
  fi
  echo "pre-commit: contract mirrors are in sync."
fi
